.fill 0x00F0 1
.fill 0x00F1 0
.fill 0x00F2 -5
.fill 0x00F3 1

// R0 is n-1
// R1 is n-2
// R2 is temporary n
// R3 is count for loop
// R4 is increment for loop

LDI 0x0 0x00F0
LDI 0x1 0x00F1
LDI 0x3 0x00F2
LDI 0x4 0x00F3

ADD 2 0 1
// Move R0 to R1
STI 0x0 0x00F4
LDI 0x1 0x00F4
// Move R2 to R0
STI 0x2 0x00F4
LDI 0x0 0x00F4

// loop logic
ADD 3 3 4
JMN 0x0008

HLT
